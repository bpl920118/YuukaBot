# Secrets & local runtime — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
**/secrets.*

# Local DB / caches
*.db
*.sqlite
*.sqlite3
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated media & probe scratch
storage/images/*
!storage/images/.gitkeep
scripts/_temp*.txt
scripts/_probe*.txt

# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
