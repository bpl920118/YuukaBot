DISCORD_TOKEN=

# OpenAI-compatible chat API (e.g. DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Prefer deepseek-v4-flash (main). Use deepseek-v4-pro for heavier reasoning.
# Legacy deepseek-chat / deepseek-reasoner are deprecated ??avoid for new deploys.
DEEPSEEK_MODEL=deepseek-v4-flash
# Thinking depth default when teacher has not set （深度…�?: off | high | max
DEEPSEEK_DEPTH=off
# Flash dialogue sampling (ignored when thinking is on)
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.9
LLM_MAX_TOKENS=768

# Stable Diffusion WebUI API (A1111 / Forge).
# Cloud deploy: leave empty (chat only). Later: Tailscale/LAN URL, e.g. http://100.x.y.z:7860
# Local same-PC: http://127.0.0.1:7860
SD_WEBUI_URL=
SD_WEBUI_CHECKPOINT=kivotos-xl-2.0.safetensors
SD_WEBUI_SAMPLER=Euler a
SD_WEBUI_STEPS=28
SD_WEBUI_CFG=7
SD_WEBUI_WIDTH=832
SD_WEBUI_HEIGHT=1216
SD_WEBUI_TIMEOUT=300

DATABASE_URL=sqlite+aiosqlite:///./yuuka.db
IMAGE_DIR=./storage/images

# Only this Discord user may change bot settings / be called ?�師
TEACHER_USER_ID=695576841125232661

CG_COOLDOWN_SECONDS=600
CG_DAILY_LIMIT=8
USER_CHAT_COOLDOWN_SECONDS=3
MEMORY_LIMIT=16

MAX_AFFECTION_DELTA=15
