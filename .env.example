DISCORD_TOKEN=

# Default provider when Discord has no /api override: deepseek | gemini | openai
LLM_PROVIDER=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Prefer deepseek-v4-flash (main). Use deepseek-v4-pro for heavier reasoning.
DEEPSEEK_MODEL=deepseek-v4-flash
# Thinking depth default when teacher has not set （深度）: off | high | max
DEEPSEEK_DEPTH=off

# --- Gemini（可與 DeepSeek 並存；Discord /api switch 一鍵切）---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI（可選）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Flash dialogue sampling (ignored when thinking is on)
LLM_TEMPERATURE=0.95
LLM_TOP_P=0.92
LLM_MAX_TOKENS=2048
# Home LLM (localhost / Tailscale)
HOME_LLM_TEMPERATURE=0.9
HOME_LLM_TOP_P=0.92
# Proactive MomoTalk posts (world-constrained)
MOMOTALK_TEMPERATURE=0.95
MOMOTALK_TOP_P=0.92
MOMOTALK_MAX_TOKENS=220

# Discord 管理者也可用：
#   /api switch  → 選「Gemini · 2.5 Flash」等（最清楚）
#   /api status  → 看目前廠商／金鑰來源／模型
#   /api help    → 說明

# Stable Diffusion WebUI API (A1111 / Forge).
# Cloud deploy: leave empty (chat only). Later: Tailscale/LAN URL, e.g. http://100.x.y.z:7860
# Local same-PC: http://127.0.0.1:7860
SD_WEBUI_URL=
SD_WEBUI_CHECKPOINT=kivotos-xl-2.0.safetensors
SD_WEBUI_SAMPLER=Euler a
SD_WEBUI_STEPS=28
SD_WEBUI_CFG=7
SD_WEBUI_WIDTH=832
SD_WEBUI_HEIGHT=1216
SD_WEBUI_TIMEOUT=300

DATABASE_URL=sqlite+aiosqlite:///./yuuka.db
IMAGE_DIR=./storage/images

# Only this Discord user may change bot settings / be called 老師
TEACHER_USER_ID=695576841125232661

CG_COOLDOWN_SECONDS=600
CG_DAILY_LIMIT=8
USER_CHAT_COOLDOWN_SECONDS=3
MEMORY_LIMIT=16

MAX_AFFECTION_DELTA=15

# --- Optional home LLM (Tailscale / localhost) ---
# Comma-separated extra hostnames treated as "home" for short prompts + VRAM release.
HOME_LLM_HOSTS=
# If true, any RFC1918 private IP counts as home (default false; prefer Tailscale 100.x).
HOME_LLM_TRUST_PRIVATE=false
LORE_SCAN_DEPTH=6
LORE_MAX_CHARS=900
MEMORY_SUMMARY_MAX_CHARS=400

# --- Home VRAM auto-switch (Kobold <-> WebUI on same GPU) ---
# 1) On home PC run: YuukaLocalLLM\start_vram_agent.bat
# 2) Point bot at the agent (local or Tailscale):
HOME_VRAM_AGENT_URL=
HOME_VRAM_AGENT_TOKEN=yuuka-local
HOME_VRAM_AGENT_TIMEOUT=240
# After CG, ask agent to bring Kobold back (agent may stop WebUI)
HOME_VRAM_RELOAD_LLM=true
HOME_VRAM_RELOAD_LLM_ALWAYS=true
# Home-LLM chat: if Kobold was stopped for CG, auto switch back before reply
HOME_VRAM_ENSURE_LLM_ON_CHAT=true

# Local / ST workflow: docs/local-tavern.md
# Example Mode B (on Grok Discord, not 127.0.0.1):
#   /api url http://100.x.y.z:5001/v1
#   /api key local
#   /api model qwen2.5-7b-instruct
# Cloud DeepSeek/Gemini/OpenAI slots above stay valid; /api clear returns to them.
